# Carpeta compartida. Usa comillas simples para rutas de Windows.
LOCAL_DRIVE_ROOT='C:\Users\edwin\OneDrive\nube'

# Usuarios, sesiones y bitácora: siempre fuera de LOCAL_DRIVE_ROOT.
# Si se omite, se utiliza .local-data dentro del proyecto.
LOCAL_DATA_DIR='D:\onedrivelist-datos'

# http:// para red local; https:// si configuras HTTPS.
AUTH_URL="http://localhost:3000"

# Acceso principal de arranque; las demás cuentas se gestionan desde la web.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""

# Opcionales: firmas para vistas previas y orígenes adicionales para lecturas.
DOWNLOAD_TOKEN_SECRET=""
DOWNLOAD_ALLOWED_ORIGINS=""

# Opcional: origen accesible desde la red para enlaces y QR, sin localhost.
SHARE_BASE_URL=""

# Opcional: una cuenta OneDrive propietaria conectada desde Administración → Almacenamiento.
# Credenciales solo del servidor; nunca usar prefijos NEXT_PUBLIC_.
ONEDRIVE_CLIENT_ID=""
ONEDRIVE_CLIENT_SECRET=""
# Plataforma Web en Entra: registrar exactamente esta URI.
# HTTP solo para localhost; en producción usar HTTPS.
ONEDRIVE_REDIRECT_URI="http://localhost:3000/api/admin/onedrive/callback"
ONEDRIVE_TENANT="consumers"
ONEDRIVE_ROOT_FOLDER="OneDriveList"
